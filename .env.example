# Desarrollo local. Copiar a .env (ignorado por Git).
# Producción: NODE_ENV=production, SEED_DEMO=false y completar los obligatorios.
# Nunca publicar credenciales ni reutilizar las cuentas demo en producción.

# EJECUCIÓN: obligatorias en producción
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_NAME=Mecan Cloud
APP_URL=http://localhost:3000
# true SOLO detrás de un proxy controlado que sobrescriba X-Forwarded-For.
TRUST_PROXY=false
SESSION_DAYS=14
LOG_LEVEL=info

# TÚNEL: publicar esta PC en internet sin abrir puertos ni depender de la IP local.
# APP_URL lleva la dirección pública del túnel y es la única fuente de esa dirección: el servidor
# rechaza todo POST cuyo origen no coincida con ella, y la app Android exige que la actualización
# venga de ese mismo origen. Con un túnel delante, TRUST_PROXY debe ser true o cada visita quedaría
# registrada con la IP del agente en lugar de la real.
#   APP_URL=https://mecan.ngrok-free.app
#   TRUST_PROXY=true
# Puesta en marcha: docs/TUNEL.md   ·   Arranque: npm run tunnel

# POSTGRESQL: obligatorio para ejecutar la aplicación y las pruebas de integración.
# Guardar la URL real exclusivamente en .env privado/gestor de secretos.
# Formato: postgresql://usuario:clave-url-encoded@host:5432/base (sin query string).
DATABASE_URL=
DATABASE_SCHEMA=mecan
# verify-full valida certificado y nombre del servidor. disable solo loopback/desarrollo
# o una red privada controlada explícitamente mediante DATABASE_TRUSTED_NETWORK=true.
DATABASE_SSL_MODE=verify-full
# Opcional si el proveedor usa una CA privada: ruta al certificado PEM (no a una clave).
DATABASE_SSL_CA_FILE=
DATABASE_TRUSTED_NETWORK=false
# Opcionales; dimensionar el total de conexiones de todas las réplicas.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_TRANSACTION_IDLE_TIMEOUT_MS=30000
# Opcional: directorio de pg_dump/pg_restore si no están disponibles en PATH.
POSTGRES_BIN_PATH=
# Solo recuperación manual: destino vacío distinto del origen; nunca publicar su clave.
RESTORE_DATABASE_URL=
RESTORE_STORAGE_PATH=

# LEGACY: solo recuperación de respaldos SQLite anteriores e importación explícita.
# DATABASE_PATH no selecciona la base del servidor HTTP: el runtime usa DATABASE_URL.
DATABASE_PATH=./data/mecan.db
STORAGE_PATH=./storage
BACKUP_PATH=./backups
# Directorio con el APK publicado y su manifest.json (movile/scripts/publish-release.js los deja ahí).
# El servidor solo lo lee; si está vacío, /movil informa que todavía no hay versión publicada.
MOBILE_RELEASES_PATH=./movile/releases
# Copia completa diaria solo en producción. La copia fuera del host debe configurarse.
BACKUP_INTERVAL_HOURS=24

# ALTA INICIAL: obligatorias en producción; no modifican un administrador existente.
SEED_DEMO=true
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# CORREO: recuperación de acceso obligatoria en producción.
# disabled solo desarrollo; smtp o webhook en producción.
EMAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
EMAIL_FROM=
# Opcional, dirección real de respuesta.
EMAIL_REPLY_TO=

# WEBHOOK OPCIONAL: alternativa a SMTP, o transporte para otros canales.
# Requiere receptor real HTTPS; no es una pasarela de pagos.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# IDENTIDAD COMERCIAL: obligatorias antes de producción; teléfono opcional.
COMPANY_LEGAL_NAME=
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_PHONE=
SUPPORT_EMAIL=
# Archivos UTF-8 de términos y privacidad aprobados, fuera de Git si contienen datos privados.
TERMS_FILE=
PRIVACY_FILE=

# COBRANZA: instrucciones reales de transferencia/manual; jamás números inventados.
SAAS_PAYMENT_INSTRUCTIONS=
# true solo tras revisar los planes/precios/reglas existentes desde Panel SaaS.
COMMERCIAL_CONFIG_APPROVED=false

# DESPLIEGUE CON COMPOSE/CADDY únicamente: host sin protocolo ni ruta.
# Debe coincidir con el host de APP_URL y tener DNS apuntando al servidor.
PUBLIC_HOST=

# PRUEBA SMOKE: opcionales, solamente contra un entorno de prueba.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_WORKSHOP_EMAIL=
SMOKE_WORKSHOP_PASSWORD=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
